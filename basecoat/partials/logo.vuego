<a href="/" class="btn-ghost p-2 h-12 w-full justify-start">
  <slot name="icon">
    <div class="bg-sidebar-primary text-sidebar-primary-foreground flex aspect-square size-8 items-center justify-center rounded-lg" v-if="theme?.header?.icon == nil || theme.header.icon == ''">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="h-4 w-4">
        <rect width="256" height="256" fill="none"></rect>
        <line x1="208" y1="128" x2="128" y2="208" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"></line>
        <line x1="192" y1="40" x2="40" y2="192" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"></line>
      </svg>
    </div>
    <div class="flex aspect-square size-8 items-center justify-center rounded-lg" v-else style="background-color: var(--color-primary); color: var(--color-primary-foreground)">
      <i :data-lucide="theme.header.icon" class="size-4"></i>
    </div>
  </slot>

  <div class="grid flex-1 text-left text-sm leading-tight">
    <span class="truncate font-medium">{{ theme.header.title | default("Basecoat") }}</span>
    <span class="truncate text-xs text-muted-foreground">{{ theme.header.subtitle | default("Documentation") }}</span>
  </div>
</a>
